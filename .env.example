# ==========================================
# Learnova API — Backend Environment Template
# ==========================================

PORT=5000
NODE_ENV=production
API_PREFIX=/api/v1
CORS_ORIGIN=https://your-frontend.netlify.app

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.74zx1a3.mongodb.net/learnova?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.74zx1a3.mongodb.net/learnova?retryWrites=true&w=majority

# Authentication Secrets (minimum 32 characters for JWT_SECRET)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=1d

# Administrator / Tutor Initial Credentials
ADMIN_EMAIL=admin@learnova.edu
ADMIN_PASSWORD=change_this_to_a_strong_password_at_least_12_chars

# Optional custom DNS servers (comma-separated, useful on Windows/restricted networks)
DNS_SERVERS=8.8.8.8,1.1.1.1
